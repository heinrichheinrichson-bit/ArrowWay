; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="ArrowWay"
config/version="0.14.0"
run/main_scene="res://main.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="ArrowWay"
config/features=PackedStringArray("4.7")

[display]

window/size/viewport_width=540
window/size/viewport_height=850
window/size/window_width_override=540
window/size/window_height_override=850
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input_devices]

pointing/emulate_mouse_from_touch=true

[rendering]

renderer/rendering_method="gl_compatibility"
environment/defaults/default_clear_color=Color(0.025, 0.035, 0.065, 1)
