config_version=5

[application]
config/name="ArrowWay"
config/version="0.3.1"
config/use_custom_user_dir=true
config/custom_user_dir_name="ArrowWay"
run/main_scene="res://main.tscn"

[display]
window/size/viewport_width=540
window/size/viewport_height=850
window/size/window_width_override=540
window/size/window_height_override=850
window/stretch/mode="canvas_items"

[input_devices]
pointing/emulate_mouse_from_touch=false

[rendering]
renderer/rendering_method="gl_compatibility"
environment/defaults/default_clear_color=Color(0.025, 0.035, 0.065, 1)
